#CanonicalizeHostname yes
#ServerAliveInterval 4
#ServerAliveCountMax 2
VisualHostKey=yes

Include ~/.ssh/config.local

Host github.com
    ControlMaster auto
    ControlPersist 120

Host github.com
    Hostname ssh.github.com
    Port 443
    User git

Match host *,!*.*
    Hostname %h.curl-amberjack.ts.net

Match exec "test -t 0"
    Compression yes

Host *
    Compression no
    User xk
